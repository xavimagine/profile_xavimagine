---
import EmailAstroComponent from '../components/Email.astro';
const titulo = 'Contacto';
const parrafo = '¿Buscas sumar talento a tu equipo? Actualmente estoy en búsqueda activa de una oportunidad laboral para incorporarme como desarrollador a tiempo completo. Si crees que mi perfil encaja en tu empresa o proyecto, me encantaría charlar con vosotros.Envíame un mensaje o conéctate conmigo en LinkedIn. ¡Hablemos';
import{perfiles} from'../data/perfiles'
---

<div id="contacto">
  <header class="section-title">
    <span>05/</span>
    <h2>{titulo}</h2>
  </header>
  <p>{parrafo}</p>
  <EmailAstroComponent />

  <section class="social-links">
    {
    perfiles.map((item) =>
        <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            title={item.label}
            aria-label={item.label}
        >
            <Fragment set:html={item.iconRaw} />
            <label>{item.label}</label>
        </a>
        )
    }
  </section>
</div>


<style>
  #contacto {
    width: 75%;
    max-width: 1000px;
    margin: 0 auto;
    justify-content: center;

    p{
        font-family: 'Inter', sans-serif;
        font-weight: 200;
        font-style: italic;
        font-size: 13px;
        color:#9C9A93;
        padding: 40px 0px 40px 0px;
        text-align: justify;
         text-justify: inter-character;
    }
    header {
      grid-area: header;
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      align-items: baseline;
    }

    span {
      color: #22c55e;
      font-size: 16px;
      font-family: 'Inter', sans-serif;
      margin-right: 8px;
      line-height: 1;
    }

    h2 {
      color: #f4f2ec;
      margin: 0;
      line-height: 1;
      font-size: 1.7rem;
    }
  }

  .social-links {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 1.5rem;
    a{
        text-decoration: none;
        color: white;
        display: flex;
        align-items: center;
        flex-direction: column;
        transition: transform 0.3s ease;
        &:hover{
            transform: scale(1.1);
        }
    }
    svg{
        width: 46px;
    }
  }

   
</style>
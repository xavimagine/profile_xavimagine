---
import { getImage } from 'astro:assets';

import desktopImg from '../assets/Fperfil/Pdesktop.png';
import tabletImg from '../assets/Fperfil/Ptablet.png';
import phoneImg from '../assets/Fperfil/Pphone.png';

const titulo = "Sobre mí";
const textAbout = "Mi trayectoria en el mundo de la tecnología se nutre de una combinación de lógica y creatividad. Gracias a mi formación tanto en diseño gráfico como en desarrollo full-stack (DAM y DAW), consigo tender un puente entre imágenes impresionantes y un código sólido.Para mí, el desarrollo no consiste solo en hacer que las cosas funcionen, sino en hacerlas memorables. Me apasiona crear interfaces de usuario muy interactivas y llamativas que no solo sean bonitas, sino que también hagan que la experiencia del usuario sea fluida e intuitiva. Me encanta resolver rompecabezas complejos de backend tanto como disfruto con los diseños de frontend con precisión al píxel, asegurándome de que cada aplicación que desarrollo sea potente, escalable y un placer de usar";

const mobileOptimized = await getImage({ src: phoneImg, format: 'webp' });
const tabletOptimized = await getImage({ src: tabletImg, format: 'webp' });
const desktopOptimized = await getImage({ src: desktopImg, format: 'webp' });

const altText = "Foto de perfil del portfolio llamado javier diaz rayo";
---

<section class="about-section" id="sobre-mi">
  <div class="about">
    <header class="section-title">
      <span>01/</span>
      <h2>{titulo}</h2>
    </header>

    <picture class="profile-picture">
      <source media="(min-width: 1024px)" srcset={desktopOptimized.src} />
      <source media="(min-width: 768px)" srcset={tabletOptimized.src} />
      <img src={mobileOptimized.src} alt={altText} width={mobileOptimized.attributes.width} height={mobileOptimized.attributes.height} />
    </picture>

    <p>{textAbout}</p>
  </div>
</section>

<style>
  section {
    background-color: rgba(36, 36, 33, 0.8);
    width: 100%;
    padding: 3rem 2rem;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }

  .about {
    max-width: 1000px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: repeat(3, auto);
    grid-template-areas:
      "header"
      "img"
      "p";
    gap: 1.5rem;
  }

  header {
    grid-area: header;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: baseline;
  }

  span {
    color: #22C55E;
    font-size: 16px;
    font-family: 'Inter', sans-serif;
    margin-right: 8px;
    line-height: 1;
  }

  h2 {
    color: #F4F2EC;
    margin: 0;
    line-height: 1;
    font-size: 1.7rem;
  }

  p {
    color: #9C9A93;
    grid-area: p;
    margin: 12px;
    font-size: 10px;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    line-height: 1.6;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    text-justify: inter-character;
  }

  /* Estilos para el contenedor de la imagen (<picture> e <img>) */
  .profile-picture {
    grid-area: img;
    justify-self: center;
    width: 100%;
    max-width: 194px;
  }

  .profile-picture img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    display: block;
    object-fit: cover;
  }

  /* ESCRITORIO */
  @media (min-width: 768px) {
    .section-title {
      font-size: 2rem;
      margin-bottom: 2.5rem;
    }

    section {
      padding: 3rem 6rem;
    }

    .about {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "header img"
        "p      img";
      gap: 2rem;
    }

    .about p {
      font-size: 14px;
    }

    .profile-picture {
      max-width: 208px;
      justify-self: end; 
    }
  }
</style>
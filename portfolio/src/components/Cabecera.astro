---
import LogoSVG from '../assets/logo.svg';
import { navItems } from '../data//navegation';
const isHome = Astro.url.pathname === '/';
const buildHref = (href: string) => (isHome ? href : `/${href}`);
---

<header class="header">
  <a href='/' id="up">
     <LogoSVG id="logo"/>
  </a>

<!-- Menú Pc -->
  <nav class="nav">
      {navItems.map((item) => (
        <a href={buildHref(item.href)}>{item.label}</a>
      ))}
  </nav>
</header>

<!-- Menú Móvil/tablet -->
<nav  id="navphone">
  {navItems.map((item) => (
    <a href={buildHref(item.href)} set:html={item.iconRaw} />
  ))}
</nav>



<style>
  .header {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 1.4rem 0rem 2rem 0rem;
    background-color: rgba(36, 36, 33, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 50;

    #logo  {
      width: 200px;
    }
  }



  .nav{
    margin-top: 20px;
  }
  .nav a {
    color: #cccccc;
    margin-left: 1.5rem;
    text-decoration: none;
    font-family: Inter;
    font-size: 0.9rem;
  }

  .nav a:hover {
    color: #00ff66;
  }
    @keyframes temporalGreenSvg {
    0%, 85% {
      stroke: #00ff66; /* Verde durante 8.5 segundos */
    }
    100% {
      stroke: #cccccc; /* Transición de vuelta al color original a los 10s */
    }
  }
  
  #navphone{
    -webkit-backface-visibility: hidden;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;

    display: none;
    width: 90%;
    background-color: rgba(36, 36, 33, 0.223);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px); 
    max-width: 334px;
    height: 55px;
    align-items: center;
    justify-content: space-around; 
    border-radius: 39px;
    margin: 0;
    position: fixed;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px)); 
    left: 50%;
    transform: translateX(-50%) translateZ(0);
    will-change: transform;
  

    a {
      margin-left: 0;
      display: flex;
      & :global(svg) {
        stroke: #cccccc;
        fill: none;
      }
      &:link,
      &:visited,
      &:hover,
      &:active,
      &:focus {
        color: #cccccc;
        outline: none;
      }
      svg{
        stroke: #cccccc;
      }
      svg.temporal-green {
        animation: temporalGreenSvg 2s ease forwards;
      }
    }
  }

  @media (max-width: 1024px) {
    .nav{
      display: none;
    }
    #navphone {
      display: flex;

    }

  }
</style>

<script>
  document.querySelectorAll('nav a').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const targetAnchor = (e.target as HTMLElement).closest('a');
      const targetId = targetAnchor?.getAttribute('href');

      if (targetId && targetId.startsWith('#')) {
        e.preventDefault();
        const targetElement = document.querySelector(targetId);

        if (targetElement) {
          const header = document.querySelector('.header');
          const headerHeight = header ? header.getBoundingClientRect().height : 0;

          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.scrollY - headerHeight;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      }
    });
  });

  // Animación del icono verde
  document.querySelectorAll('#navphone a svg').forEach(target => {
    target.addEventListener('click', function() {
      target.classList.remove('temporal-green');
      void target.getBoundingClientRect();
      target.classList.add('temporal-green');
    });
  });

  const scrollTopBtn = document.getElementById("up");

scrollTopBtn?.addEventListener("click", function(e) {
    e.preventDefault(); 

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
});
</script>